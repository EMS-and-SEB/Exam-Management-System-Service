
DATABASE_URL=postgresql://user:password@localhost:5432/exam_management_system

PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=<a real random string, 32+ characters>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_MS=604800000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

EMAIL_FROM=noreply@yourdomain.test
SMTP_HOST=localhost
SMTP_PORT=1025

EXAM_ADMIN_EMAIL=admin@ems.local
EXAM_ADMIN_PASSWORD=<a real, strong password>
EXAM_ADMIN_NAME=Exam Administrator

SEB_CLIENT_KEY=<a real random strinG--this exact value needs to be embedded in the SEB Windows client's build config too>
SEB_HANDSHAKE_SECRET=<a real random string>